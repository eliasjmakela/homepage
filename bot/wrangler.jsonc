{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "now-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-09",
  "observability": {
    "enabled": true
  },
  "vars": {
    "GITHUB_REPO": "eliasjmakela/homepage",
    "GITHUB_BRANCH": "production",
    "GITHUB_FILE_PATH": "src/content/now.json"
  }
}
